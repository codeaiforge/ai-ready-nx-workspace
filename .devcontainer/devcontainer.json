{
  "name": "Payment Reconciliation Demo",

  // Mirrors .github/workflows/ci.yml so a container run and a CI run agree.
  // Versions are kept in step with .tool-versions.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    // JDK 25 — the poms compile with release 25. Formatting also needs it:
    // older google-java-format calls a javac internal removed after 21.
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "tem",
      "installMaven": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      // Must match the "packageManager" field in package.json. A container pnpm that
      // differs from the host's makes pnpm treat a bind-mounted node_modules as foreign.
      "pnpmVersion": "10.15.1"
    },
    // Testcontainers starts a real Postgres for the service's integration test,
    // so the container needs its own Docker daemon.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // osv-scanner backs the dependency-check target (Complex-tier security phase). No
  // devcontainer feature publishes it, so pin the release binary directly.
  "postCreateCommand": "sudo curl -sSL -o /usr/local/bin/osv-scanner https://github.com/google/osv-scanner/releases/download/v2.5.1/osv-scanner_linux_amd64 && sudo chmod +x /usr/local/bin/osv-scanner && pnpm install --frozen-lockfile --config.confirmModulesPurge=false",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "nrwl.angular-console",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic"
      }
    }
  },

  // Testcontainers pulls images and Maven resolves from Central on first run.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "remoteUser": "vscode"
}
