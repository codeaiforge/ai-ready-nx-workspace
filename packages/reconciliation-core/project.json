{
  "name": "reconciliation-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/reconciliation-core/src",
  "tags": [],
  "targets": {
    "check-format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw -q spotless:check",
        "cwd": "packages/reconciliation-core"
      }
    },
    "apply-format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw -q spotless:apply",
        "cwd": "packages/reconciliation-core"
      }
    },
    "dependency-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/reconciliation-core",
        "commands": [
          "./mvnw -q org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom",
          "osv-scanner scan source --lockfile target/bom.json"
        ],
        "parallel": false
      }
    }
  }
}
